<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>PenReceiver</RootNamespace>
    <AssemblyName>PenSelfTest</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <!--
      自检程序刻意不带管理员权限清单：它只验证协议解析、坐标换算和 UDP 收发，
      不注入任何输入，因此在普通权限、远程会话、CI 里都能直接跑。
    -->
    <AssemblyTitle>无线手写板 自检</AssemblyTitle>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PenCore\PenCore.csproj" />
  </ItemGroup>

</Project>
