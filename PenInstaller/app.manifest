<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.2.0" name="PenWirelessTablet.Setup" />

  <!--
    申请管理员权限。安装本身必须提权，两个原因缺一不可：
      1) 写入 Program Files 与 HKLM 卸载注册表项需要管理员权限；
      2) 接收端必须在提升的进程里运行——Windows 笔注入接口（InputInjector）
         只在提升的进程里可用，非提升会抛 COM 类工厂错误。
    既然用户装完总要提权运行主程序，安装时一次提权到底更省事。
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!--
    ⚠️ 不要在这里手写 DPI 设置（<application><windowsSettings><dpiAwareness>）。
    踩过的坑：手写 <application xmlns="urn:schemas-microsoft-com:asm.v3"> +
    PerMonitorV2 之后，程序启动直接报
        「应用程序无法启动，因为应用程序的并行配置不正确」
    （side-by-side configuration is incorrect）。
    因为 .NET SDK 会依据 csproj 里的 ApplicationHighDpiMode 自己生成这些节点，
    两处都写就产生了互相冲突的激活上下文。

    需要改 DPI 行为请改 csproj：
        <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    PenReceiver 的 app.manifest 里也有同样的提醒，两处保持一致。
  -->
</assembly>
