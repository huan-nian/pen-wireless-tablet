# 仓库内统一存储 LF，避免 Android 端与 Windows 端换行符互相污染
* text=auto

# 构建脚本的换行符是硬性要求，按平台固定
gradlew         text eol=lf
*.sh            text eol=lf
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# 二进制文件不做任何换行转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.jar       binary
*.apk       binary
*.aab       binary
*.jks       binary
*.keystore  binary
*.dll       binary
*.exe       binary
*.so        binary
*.zip       binary
