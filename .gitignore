# ============================================================
# 仓库统一忽略规则
#   PenClient   —— Android 端（Kotlin + Gradle，Android Studio）
#   PenReceiver —— Windows 端（C# / .NET 8，Visual Studio）
# 两端各自的 .gitignore（PenClient/.gitignore、app/.gitignore）
# 仍然生效，这里只补充仓库根目录级别的通用规则。
# ============================================================

# ---------- 操作系统与编辑器杂项 ----------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
*.log
*.tmp
*.bak

# IDE 元数据（Android Studio / IntelliJ / VS / VS Code）
.idea/
.vscode/
*.iml

# ---------- Gradle / Android 构建产物 ----------
.gradle/
.kotlin/
build/
captures/
.externalNativeBuild/
.cxx/
lint-results*.html

# 本机 SDK / NDK 路径等环境相关配置，绝不提交
local.properties
local.defaults.properties

# 签名密钥与打包产物（如确需提交，用 git add -f 强制添加）
*.jks
*.keystore
*.apk
*.aab
*.ap_
*.dex
release/

# ---------- .NET 构建产物 ----------
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo
*.userprefs
*.userosscache
*.sln.docstates
TestResults/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# ---------- 测试与覆盖率 ----------
coverage/
*.coverage
*.coveragexml

# ---------- 本地私有配置 ----------
*.local
.env
.env.*
!.env.example

# ---------- 本机排查产生的临时文件 ----------
# .acl-reports/ 是文件权限诊断脚本留下的报告与回滚脚本，只对本机有意义
.acl-reports/
.tmp-*

# ---------- 发布产物 ----------
# dist/ 由 scripts\package-release.cmd 生成，动辄几十 MB，不进仓库；
# 发布时作为 GitHub Release 的附件单独上传。
dist/
