<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- ============ 连接页（浅色）============ -->
    <color name="panel_bg">#FFF3F4F6</color>
    <color name="card_stroke">#FFDDE1E6</color>
    <color name="canvas_bg">#FFFFFFFF</color>
    <color name="text_primary">#FF1B1B1F</color>
    <color name="text_secondary">#FF5F6368</color>

    <!--
      ============ 书写页 ============
      原来用近乎纯黑的底 + 纯白画布，对比过强（长时间书写眼睛容易累）。
      现在整体走暖灰调：底是深板岩灰，画布是暖白，既有层次又不刺眼。
      画布底色可以在应用里改，这里的 canvas_default 只是出厂默认值。
    -->
    <!-- 最外层底色（按钮列与画布之间的分隔） -->
    <color name="page_bg">#FF32363C</color>
    <!-- 左侧按钮列 -->
    <color name="toolbar_bg">#FF3E434A</color>
    <!-- 图标与底部文字的默认色 -->
    <color name="toolbar_icon">#FFE6E4DF</color>
    <!-- 底部次要文字 -->
    <color name="text_soft">#FFB8BCC2</color>
    <!-- 画布出厂默认底色：暖白，比纯白柔和 -->
    <color name="canvas_default">#FFF7F5F0</color>
    <!-- 按钮按下时的底色 -->
    <color name="toolbar_pressed">#33FFFFFF</color>

    <!-- ============ 状态指示点 ============ -->
    <color name="dot_idle">#FF9AA0A6</color>
    <color name="dot_ok">#FF6BBF7B</color>
    <color name="dot_busy">#FFE0A44A</color>
</resources>
