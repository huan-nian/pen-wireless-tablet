<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      基础主题：Material 3，无 ActionBar。
      连接页是浅色的，所以状态栏/导航栏跟随面板底色并使用深色图标。
    -->
    <style name="Base.Theme.PenClient" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/panel_bg</item>
        <item name="android:navigationBarColor">@color/panel_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.PenClient" parent="Base.Theme.PenClient" />

    <!--
      书写页主题：整页暖灰调，书写时不该有浅色系统栏或纯黑边框干扰。
      状态栏与导航栏都跟随页面底色，图标用浅色。
    -->
    <style name="Theme.PenClient.Fullscreen" parent="Base.Theme.PenClient">
        <item name="android:statusBarColor">@color/toolbar_bg</item>
        <item name="android:navigationBarColor">@color/toolbar_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!--
      左侧工具栏按钮。用 ImageButton + tint 统一着色，避免每个图标各写一份颜色；
      按下时用圆角高亮给出反馈。
    -->
    <style name="ToolButton">
        <item name="android:layout_width">@dimen/tool_button_size</item>
        <item name="android:layout_height">@dimen/tool_button_size</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:background">@drawable/tool_button_bg</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
        <!-- 用 app:tint（AppCompatImageButton）而不是已废弃的 android:tint -->
        <item name="tint">@color/toolbar_icon</item>
    </style>

    <!-- 按钮分组之间的间隔线：留白而不是画线，视觉更干净 -->
    <style name="ToolDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/tool_divider_height</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
