<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      基础主题：Material 3，无 ActionBar。
      手写板界面不需要系统栏抢注意力，所以状态栏/导航栏都用浅色并跟随面板底色。
    -->
    <style name="Base.Theme.PenClient" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/panel_bg</item>
        <item name="android:navigationBarColor">@color/panel_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.PenClient" parent="Base.Theme.PenClient" />
</resources>
