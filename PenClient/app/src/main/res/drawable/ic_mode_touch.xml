<?xml version="1.0" encoding="utf-8"?>
<!--
  触摸模式图标：一根手指点在一条横线上。
  与「手写笔模式」是同一按钮的两态，图标不变、只换文字，避免用户以为换了按钮。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 手指：圆头指肚 + 指身 -->
    <path
        android:pathData="M12,3.4 A2.1,2.1 0 1,1 11.99,3.4 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M12,6.2 L12,13.4"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- 触摸面：一条横线加落点 -->
    <path
        android:pathData="M4.2,17.2 L19.8,17.2"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M12,17.2 L12,20.4"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
